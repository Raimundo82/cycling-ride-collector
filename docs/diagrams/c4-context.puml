@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title System Context diagram for Go Strava Weekly

Person(athlete, "Athlete", "A cyclist or endurance athlete who tracks their workouts on Strava")

System(strava_weekly, "Go Strava Weekly", "Fetches workout data from Strava and syncs it to Google Sheets for weekly analysis and tracking")

System_Ext(strava, "Strava API", "Provides access to athlete's workout data including power, heart rate, distance, and duration metrics")

System_Ext(sheets, "Google Sheets", "Stores and displays weekly workout summaries for easy analysis and visualization")

Rel(athlete, strava_weekly, "Runs weekly sync", "Manual execution / Scheduled cron")
Rel(strava_weekly, strava, "Fetches workouts", "HTTPS/REST")
Rel(strava_weekly, sheets, "Exports workout data", "Google Sheets API")
Rel(athlete, strava, "Records workouts", "Mobile/Web App")
Rel(athlete, sheets, "Views weekly summaries", "Web Browser")

@enduml
